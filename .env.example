# Environment config
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://localhost:27017/enterprise-backend

# Authentication & Sessions
SESSION_SECRET=supersecret_change_me_in_production

# Web app (used to build links in emails)
FRONTEND_URL=http://localhost:5173

# Outbound email. Leave SMTP_HOST empty in development to use a throwaway Ethereal inbox.
# Microsoft 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_SECURE=false, SMTP_USER=<the sending mailbox, same as EMAIL_FROM>.
# Then either SMTP_PASS (basic auth, being switched off by Microsoft) or the three SMTP_OAUTH_* values (recommended).
# Check the settings with: pnpm email:verify you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_OAUTH_TENANT_ID=
SMTP_OAUTH_CLIENT_ID=
SMTP_OAUTH_CLIENT_SECRET=
EMAIL_FROM="Yesdoc Healthcare" <compliance@yesdochealthcare.co.uk>
EMAIL_REPLY_TO=compliance@yesdochealthcare.co.uk
# Public base URL of the email letterhead images (this server's /email-assets, or a CDN)
EMAIL_ASSET_BASE_URL=http://localhost:5000/email-assets
